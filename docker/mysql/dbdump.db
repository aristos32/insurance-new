DROP TABLE IF EXISTS `owneraddress`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!40101 SET character_set_client = utf8 */;
CREATE TABLE `owneraddress` (
  `addressId` int(10) NOT NULL AUTO_INCREMENT,
  `addressType` varchar(30) DEFAULT NULL,
  `street` varchar(60) DEFAULT NULL,
  `areaCode` varchar(10) DEFAULT NULL,
  `city` varchar(50) DEFAULT NULL,
  `state` varchar(20) DEFAULT NULL,
  `country` varchar(50) DEFAULT NULL,
  `stateId` varchar(20) NOT NULL,
  UNIQUE KEY `addressId` (`addressId`),
  KEY `stateId` (`stateId`),
  CONSTRAINT `owneraddress_ibfk_1` FOREIGN KEY (`stateId`) REFERENCES `owner` (`stateId`) ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB AUTO_INCREMENT=4372 DEFAULT CHARSET=utf8;
/*!40101 SET character_set_client = @saved_cs_client */;

