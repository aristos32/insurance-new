--

DROP TABLE IF EXISTS `medical`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!40101 SET character_set_client = utf8 */;
CREATE TABLE `medical` (
  `saleId` varchar(20) NOT NULL,
  `frequencyOfPayment` varchar(20) DEFAULT NULL,
  `premium` double(10,2) DEFAULT NULL,
  `planName` varchar(20) DEFAULT NULL,
  `planMaximumLimit` int(12) DEFAULT NULL,
  `deductible` int(8) DEFAULT NULL,
  `excess` int(8) DEFAULT NULL,
  `coInsurancePercentage` int(3) DEFAULT NULL,
  `roomType` varchar(30) DEFAULT NULL,
  `outpatientAmount` int(6) DEFAULT NULL,
