DROP TABLE IF EXISTS `lifeins`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!40101 SET character_set_client = utf8 */;
CREATE TABLE `lifeins` (
  `saleId` varchar(20) NOT NULL,
  `insuredFirstName` varchar(70) DEFAULT NULL,
  `insuredLastName` varchar(70) DEFAULT NULL,
  `frequencyOfPayment` varchar(20) DEFAULT NULL,
  `annualPremium` double(10,2) DEFAULT NULL,
  `monthlyPremium` double(10,2) DEFAULT NULL,
  `planName` varchar(20) DEFAULT NULL,
  `basicPlanAmount` double(10,2) DEFAULT NULL,
  `totalPermanentDisabilityAmount` double(10,2) DEFAULT NULL,
  `premiumProtectionAmount` double(10,2) DEFAULT NULL,
  PRIMARY KEY (`saleId`),
  CONSTRAINT `lifeins_ibfk_1` FOREIGN KEY (`saleId`) REFERENCES `sale` (`saleId`) ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8;
/*!40101 SET character_set_client = @saved_cs_client */;

