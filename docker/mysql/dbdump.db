--
-- Table structure for table `quotation`
--

DROP TABLE IF EXISTS `quotation`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!40101 SET character_set_client = utf8 */;
CREATE TABLE `quotation` (
  `quoteId` int(10) NOT NULL AUTO_INCREMENT,
  `canProvideOnlineQuote` varchar(5) DEFAULT NULL,
  `entryDate` datetime NOT NULL,
  `quoteAmount` int(6) NOT NULL,
  `insuranceCompanyOfferingQuote` varchar(50) DEFAULT NULL,
  `offerSelected` varchar(20) DEFAULT NULL,
  `coverageType` varchar(50) DEFAULT NULL,
  `username` varchar(40) DEFAULT NULL,
  `userInfo` varchar(255) DEFAULT NULL,
  UNIQUE KEY `quoteId` (`quoteId`)
) ENGINE=InnoDB AUTO_INCREMENT=112 DEFAULT CHARSET=utf8;
/*!40101 SET character_set_client = @saved_cs_client */;

