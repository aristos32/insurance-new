--
-- Table structure for table `emailpreferences`
--

DROP TABLE IF EXISTS `emailpreferences`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!40101 SET character_set_client = utf8 */;
CREATE TABLE `emailpreferences` (
  `stateId` varchar(20) NOT NULL,
  `preferenceCode` varchar(50) DEFAULT NULL,
  `preferenceFrequency` varchar(50) DEFAULT NULL,
  UNIQUE KEY `stateId` (`stateId`),
  CONSTRAINT `emailpreferences_ibfk_1` FOREIGN KEY (`stateId`) REFERENCES `owner` (`stateId`) ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8;
/*!40101 SET character_set_client = @saved_cs_client */;

